{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "core/**/*.ts",
    "modules/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.d.ts",
    "scripts/**/*.ts"
  ]
}
