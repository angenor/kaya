# Modèle de configuration — copier en `backend/.env` et adapter.
#
# **Deux chaînes de connexion distinctes, jamais une seule élargie** (R-12) : les migrations
# s'exécutent sous le rôle propriétaire, le runtime sous le rôle applicatif soumis à la RLS. Un
# rôle unique annulerait l'effet de `FORCE ROW LEVEL SECURITY`.
DATABASE_URL=postgres://kaya_owner:CHANGEZ_MOI@localhost:5433/kaya
DATABASE_URL_APP=postgres://kaya_app:CHANGEZ_MOI@localhost:5433/kaya

# Rôle du test de reconstitution autonome : lecture du grand livre, et RIEN d'autre (R-11).
DATABASE_URL_LEDGER=postgres://kaya_ledger_reader:CHANGEZ_MOI@localhost:5433/kaya

# Éphémère reconstructible UNIQUEMENT (principe II).
REDIS_URL=redis://localhost:6380

# Stockage objet, consommé via l'API S3 uniquement.
#
# Les deux clés sont produites par `scripts/dev/preparer-stockage.sh`, qui initialise le cluster
# Garage local. Un conteneur Garage qui démarre est SAIN SANS ÊTRE UTILISABLE : son nœud n'a aucun
# rôle assigné, aucune clé n'existe, aucun compartiment non plus — et `docker compose ps` le
# rapporte pourtant `healthy`, ce qui est exact : le service répond. C'est la sonde `/health`, qui
# tente un appel S3 réel, qui fait la différence.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=kaya-dev
S3_ACCESS_KEY=CHANGEZ_MOI
S3_SECRET_KEY=CHANGEZ_MOI

KAYA_PORT=8080

# Montage conditionnel de Swagger UI. **Vide ou absent en production** (FR-032) : une route non
# montée ne peut pas fuir par oubli de garde.
KAYA_SWAGGER_UI=1

# Rapport d'erreurs. Vide = désactivé.
SENTRY_DSN=

# La dérogation CONTEXTE_PAR_EN_TETES — ouverte le 2026-07-31, **LEVÉE le 2026-08-01** (CPT-01,
# tâche T030). `KAYA_CONTEXTE_PAR_EN_TETES` n'existe plus, et les en-têtes `x-kaya-tenant` et
# `x-kaya-compte` non plus : le contexte vient du jeton porté par `Authorization: Bearer`.
#
# Laissée en commentaire une version, puis retirée : une variable morte encore posée dans un
# fichier d'environnement finit copiée sur le serveur suivant, où plus personne ne sait ce qu'elle
# faisait.

# Worker de publication — lecture tous tenants sur le SEUL grand livre (migration 0005).
DATABASE_URL_WORKER=postgres://kaya_worker:CHANGEZ_MOI@localhost:5433/kaya

# =============================================================================================
#  CPT-01 — les deux secrets du cycle 003. AUCUN N'A DE VALEUR PAR DÉFAUT.
# =============================================================================================
#
# Un défaut serait un secret publié : il vivrait dans le dépôt, dans l'image et dans les archives
# de tous les postes ayant cloné le projet. Le binaire **refuse de démarrer** sans la première.

# Clé de signature des jetons de session — **32 octets au minimum** (RFC 7518 §3.2 : la clé HMAC
# ne descend pas sous la taille de l'empreinte). Une clé par environnement, jamais partagée.
#
#     openssl rand -base64 48
#
# La changer invalide toutes les sessions en cours. C'est le recours de dernier ressort si elle
# fuit — la révocation ordinaire passe par Redis, pas par une rotation de clé.
KAYA_JWT_CLE=CHANGEZ_MOI_32_OCTETS_AU_MINIMUM_0

# Mot de passe des comptes de démonstration, lu par le SEUL binaire `seeds`. Le serveur ne
# l'exige pas : il refuserait de démarrer en production, où les seeds ne s'exécutent jamais.
KAYA_SEEDS_MOT_DE_PASSE=CHANGEZ_MOI

# Environnement d'exécution. Les seeds REFUSENT de s'exécuter si cette variable vaut `production`
# ou `prod` — la garde vit dans le binaire, pas dans un script : c'est bien le binaire qu'on lance
# à la main un soir d'incident en cherchant à « juste remettre les données de démonstration ».
# Absente = pas la production.
KAYA_ENVIRONNEMENT=developpement
