# Modèle de configuration — copier en `backend/.env` et adapter.
#
# **Deux chaînes de connexion distinctes, jamais une seule élargie** (R-12) : les migrations
# s'exécutent sous le rôle propriétaire, le runtime sous le rôle applicatif soumis à la RLS. Un
# rôle unique annulerait l'effet de `FORCE ROW LEVEL SECURITY`.
DATABASE_URL=postgres://kaya_owner:CHANGEZ_MOI@localhost:5433/kaya
DATABASE_URL_APP=postgres://kaya_app:CHANGEZ_MOI@localhost:5433/kaya

# Rôle du test de reconstitution autonome : lecture du grand livre, et RIEN d'autre (R-11).
DATABASE_URL_LEDGER=postgres://kaya_ledger_reader:CHANGEZ_MOI@localhost:5433/kaya

# Éphémère reconstructible UNIQUEMENT (principe II).
REDIS_URL=redis://localhost:6380

# Stockage objet, consommé via l'API S3 uniquement.
#
# Les deux clés sont produites par `scripts/dev/preparer-stockage.sh`, qui initialise le cluster
# Garage local. Un conteneur Garage qui démarre est SAIN SANS ÊTRE UTILISABLE : son nœud n'a aucun
# rôle assigné, aucune clé n'existe, aucun compartiment non plus — et `docker compose ps` le
# rapporte pourtant `healthy`, ce qui est exact : le service répond. C'est la sonde `/health`, qui
# tente un appel S3 réel, qui fait la différence.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=kaya-dev
S3_ACCESS_KEY=CHANGEZ_MOI
S3_SECRET_KEY=CHANGEZ_MOI

KAYA_PORT=8080

# Montage conditionnel de Swagger UI. **Vide ou absent en production** (FR-032) : une route non
# montée ne peut pas fuir par oubli de garde.
KAYA_SWAGGER_UI=1

# Rapport d'erreurs. Vide = désactivé.
SENTRY_DSN=

# Dérogation CONTEXTE_PAR_EN_TETES — ouverte le 2026-07-31, levée par CPT-01.
#
# Tant que l'authentification par jeton n'existe pas, le tenant et le compte se lisent dans les
# en-têtes `x-kaya-tenant` et `x-kaya-compte`. Toute personne joignant l'API choisit donc son
# tenant. **Jamais en production** — le binaire refuse de démarrer sans cette variable, pour que
# l'oubli soit un échec bruyant plutôt qu'une faille silencieuse.
KAYA_CONTEXTE_PAR_EN_TETES=1

# Worker de publication — lecture tous tenants sur le SEUL grand livre (migration 0005).
DATABASE_URL_WORKER=postgres://kaya_worker:CHANGEZ_MOI@localhost:5433/kaya
