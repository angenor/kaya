  "query": "\n        SELECT b.formule_id, b.duree_minutes, b.prix_mineur\n        FROM hebergement.bareme_palier b\n        JOIN hebergement.formule f ON f.id = b.formule_id\n        WHERE f.etablissement_id = $1\n        ORDER BY b.duree_minutes\n        ",
