  "query": "\n        SELECT u.id, u.categorie_id, u.code, u.etage, u.statut_menage\n        FROM hebergement.unite u\n        JOIN hebergement.categorie c ON c.id = u.categorie_id\n        WHERE u.etablissement_id = $1\n        ORDER BY c.nom, u.code\n        ",
