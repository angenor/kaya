{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.code, u.etage, u.statut_menage\n        FROM hebergement.unite u\n        WHERE u.etablissement_id = $1\n          AND u.categorie_id = $2\n          AND NOT EXISTS (\n              SELECT 1\n              FROM hebergement.occupation o\n              WHERE o.unite_id = u.id\n                AND o.periode && $3\n          )\n        ORDER BY u.code\n        ",
