  "query": "\n            SELECT c.id AS \"id!\",\n                   TRIM(COALESCE(p.prenoms, '') || ' ' || p.nom) AS \"nom_affichage!\",\n                   c.actif AS \"actif!\"\n            FROM comptes.compte c\n            JOIN comptes.personne p ON p.id = c.personne_id\n            WHERE c.id = ANY($1)\n            ",
