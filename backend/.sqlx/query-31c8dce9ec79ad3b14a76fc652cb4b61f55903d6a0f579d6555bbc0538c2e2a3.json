  "query": "\n        SELECT p.id, p.formule_id, p.heure_debut, p.heure_fin, p.libelle_cle\n        FROM hebergement.plage_demi_journee p\n        JOIN hebergement.formule f ON f.id = p.formule_id\n        WHERE f.etablissement_id = $1\n        ORDER BY p.heure_debut\n        ",
