  "query": "\n        SELECT p.id                         AS \"id!\",\n               p.nom                        AS \"nom!\",\n               p.prenoms,\n               p.telephone,\n               (p.numero_piece IS NOT NULL) AS \"piece_enregistree!\"\n        FROM comptes.personne p\n        INNER JOIN comptes.client c ON c.personne_id = p.id\n        WHERE p.id = ANY($1)\n        ",
