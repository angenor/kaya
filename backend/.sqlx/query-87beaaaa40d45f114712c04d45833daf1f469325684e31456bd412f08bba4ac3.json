  "query": "\n        SELECT cr.compte_id, cr.role_code, cr.etablissement_id\n        FROM comptes.compte_role cr\n        JOIN comptes.role r ON r.code = cr.role_code\n        WHERE cr.compte_id = ANY($1)\n        ORDER BY r.ordre, cr.etablissement_id\n        ",
